# ===== Turso 資料庫 =====
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===== LINE LIFF =====
LIFF_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LIFF_CHANNEL_SECRET=your-line-channel-secret

# ===== 伺服器 =====
PORT=3000
CORS_ORIGIN=https://your-liff-app.vercel.app

# ===== 初始管理者 LINE User ID (多個用逗號分隔) =====
INITIAL_ADMIN_IDS=U1234567890abcdef
