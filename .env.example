# ============================================
# 有Ball必In 籃球歡樂打社團 — 環境變數範本
# 複製此檔為 .env 並填入真實值
# ============================================

# ===== Turso 資料庫 =====
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# ===== LINE Messaging API =====
LIFF_CHANNEL_ACCESS_TOKEN=your-line-channel-access-token
LIFF_CHANNEL_SECRET=your-line-channel-secret

# ===== 前端環境變數（Vite 前綴 VITE_） =====
VITE_LIFF_ID=1234567890-AbCdEfGh
# 同站部署到 Vercel 時留空（使用相對路徑 /api）
# 前後端分開部署時填後端網址，如 https://api.example.com
VITE_API_BASE_URL=

# ===== 初始管理者 LINE User ID（多個用逗號分隔）=====
# 僅 server/ 的 db:init 腳本使用，Vercel 部署不需要
INITIAL_ADMIN_IDS=
